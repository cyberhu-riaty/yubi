<!-- 公共环境：模型库中的纯机械臂 XML 会在加载时与本文件组合。 -->
<mujoco model="yubi_shared_environment">
  <asset>
    <texture name="ground_tex" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.18 0.36 0.58" rgb2="0.78 0.87 0.95"/>
    <material name="ground_mat" texture="ground_tex" texrepeat="8 8"
              texuniform="true" reflectance="0.10"/>
  </asset>

  <worldbody>
    <light name="scene_light" pos="0 0 3" dir="0 0 -1" directional="true"
           diffuse="0.85 0.85 0.85" specular="0.20 0.20 0.20"/>
    <geom name="floor" type="plane" size="3 3 0.1" material="ground_mat"
          contype="1" conaffinity="1" condim="3" friction="1 0.005 0.0001"/>
  </worldbody>
</mujoco>

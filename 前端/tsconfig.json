{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      // 生成物（契约.ts / 风格.ts）落在 软件/web/ —— 由 Python 侧生成，
      // 这里用别名指过去，前端就不必"抄一份契约"。
      "@生成/*": ["./src/生成/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
